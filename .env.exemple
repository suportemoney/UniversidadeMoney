# Copiar para .env na raiz (não versionar).
# Local: DJANGO_DEBUG=1 e DB_* de desenvolvimento.
# VPS: DJANGO_DEBUG=0, DB_HOST=db, hosts/CORS do domínio de produção.

# --- Acesso VPS (máquina local / GitHub Secrets; opcional na VPS) ---
VPS_HOST=
VPS_USER=root
VPS_PORT=22
VPS_DOMAIN=universidade.moneypromotora.com.br
PASSWORD_VPS=

# --- Django ---
APP_ENV=development
DJANGO_SECRET_KEY=
SECRET_KEY=
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,nginx
ALLOWED_HOSTS=localhost,127.0.0.1,backend,nginx
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:5175
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:5175
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# --- PostgreSQL ---
POSTGRES_USER=universidade_user
POSTGRES_PASSWORD=devpassword
POSTGRES_DB=universidade_money_dev
DB_USER=universidade_user
DB_PASSWORD=devpassword
DB_NAME=universidade_money_dev
DB_HOST=db
DB_PORT=5432

# --- Superuser (só desenvolvimento) ---
SUPERUSER_USERNAME=admin
SUPERUSER_EMAIL=admin@localhost
SUPERUSER_PASSWORD=admin123

# --- Portas publicadas no Docker local ---
DB_PUBLISH_PORT=5433
BACKEND_PUBLISH_PORT=8000

# --- SSL na VPS ---
CERTBOT_EMAIL=admin@moneypromotora.com.br

# --- SMTP Hostinger (aspas na senha se houver #) ---
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=465
EMAIL_USE_SSL=1
EMAIL_USE_TLS=0
EMAIL_HOST_USER=notification@moneypromotora.com.br
EMAIL_HOST_PASSWORD=
EMAIL_FROM=Universidade Money <notification@moneypromotora.com.br>
EMAIL_ADMIN=admin@moneypromotora.com.br
